{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "医学统计学学习助手",
  "version": "0.1.0",
  "identifier": "com.medstats.learningassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "医学统计学学习助手",
      "width": 1440,
      "height": 920,
      "minWidth": 1024,
      "minHeight": 700,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
